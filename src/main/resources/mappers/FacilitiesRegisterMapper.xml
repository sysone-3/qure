<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="app.snapshot.qure.facilities.repository.FacilitiesRegisterMapper">

    <insert id="insertFacility" parameterType="app.snapshot.qure.facilities.dto.FacilityRegisterDTO">
        INSERT INTO facilities (facility_id, domain, name, inspector_id)
        VALUES (facility_seq.NEXTVAL, #{domain}, #{equipment}, #{inspectorId})
    </insert>

</mapper>
