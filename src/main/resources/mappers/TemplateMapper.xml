<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="app.snapshot.qure.template.repository.ITemplateRepository">

    <resultMap id="templateMap" type="app.snapshot.qure.template.dto.TemplateDto">
        <result property="templateId" column="TEMPLATE_ID" />
        <result property="domain" column="DOMAIN" />
        <result property="name" column="NAME" />
        <result property="cycle" column="CYCLE" />
        <result property="version" column="VERSION" />
        <result property="isActive" column="IS_ACTIVE" />
        <result property="createdAt" column="CREATED_AT" />
        <result property="facilityId" column="FACILITY_ID" />
    </resultMap>

    <select id="getTemplateList" resultMap="templateMap">
        select * from checklist_templates
    </select>

    <select id="searchTemplates" resultMap="templateMap">
        select *
        from checklist_templates
        <where>
            <if test="domain != null">
                domain = #{domain}
            </if>
            <if test="keyword != null and keyword != ''">
                and lower(name) like concat('%', lower(#{keyword}), '%')
            </if>
        </where>
    </select>
</mapper>