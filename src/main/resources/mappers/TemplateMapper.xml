<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="app.snapshot.qure.template.repository.ITemplateRepository">

    <resultMap id="templateMap" type="app.snapshot.qure.template.model.Template">
        <result property="templateId" column="TEMPLATE_ID" />
        <result property="domain" column="DOMAIN" javaType="app.snapshot.qure.template.model.DomainType"/>
        <result property="name" column="NAME" />
        <result property="cycle" column="CYCLE" />
        <result property="cycleUnit" column="CYCLE_UNIT" javaType="app.snapshot.qure.template.model.CycleUnit"/>
        <result property="version" column="VERSION" />
        <result property="isActive" column="IS_ACTIVE" javaType="app.snapshot.qure.template.model.ActiveStatus"/>
        <result property="createdAt" column="CREATED_AT" />
        <result property="facilityId" column="FACILITY_ID" />
    </resultMap>

    <select id="getTemplateList" resultMap="templateMap">
        select * from checklist_templates
    </select>

    <!-- 단건 조회 -->
    <select id="getTemplateById" parameterType="long" resultMap="templateMap">
        select * from checklist_templates where template_id = #{id}
    </select>

    <!-- 등록 -->
    <insert id="insertTemplate" parameterType="app.snapshot.qure.template.model.Template">
        insert into checklist_templates
        (template_id, domain, name, cycle, cycle_unit, version, is_active, created_at, facility_id)
        values (#{templateId}, #{domain}, #{name}, #{cycle}, #{cycleUnit}, #{version}, #{isActive}, sysdate, #{facilityId})
    </insert>

    <!-- 수정 -->
    <update id="updateTemplate" parameterType="app.snapshot.qure.template.model.Template">
        update checklist_templates
        set domain = #{domain},
            name = #{name},
            cycle = #{cycle},
            cycle_unit = #{cycleUnit},
            version = #{version},
            is_active = #{isActive},
            facility_id = #{facilityId}
        where template_id = #{templateId}
    </update>

    <!-- 삭제 -->
    <delete id="deleteTemplate" parameterType="long">
        delete from checklist_templates where template_id = #{id}
    </delete>
</mapper>