<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="app.snapshot.qure.facilities.repository.IFacilitiesRepository">

    <!-- Dto 매핑 -->
    <resultMap id="facilityMap" type="app.snapshot.qure.facilities.dto.FacilitiesDto">
        <result property="facilityId" column="FACILITY_ID"/>
        <result property="domain" column="DOMAIN"/>
        <result property="name" column="NAME"/>
        <result property="floor" column="FLOOR"/>
        <result property="zone" column="ZONE"/>
        <result property="address" column="ADDRESS"/>
        <result property="gpsLat" column="GPS_LAT"/>
        <result property="gpsLng" column="GPS_LNG"/>
        <result property="status" column="STATUS"/>
        <result property="memo" column="MEMO"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
        <result property="managersId" column="MANAGERS_ID"/>
        <result property="inspectorId" column="INSPECTOR_ID"/>
    </resultMap>

    <resultMap id="templateMap" type="app.snapshot.qure.facilities.dto.ChecklistTemplateDto">
        <result property="templateId" column="TEMPLATE_ID"/>
        <result property="domain" column="DOMAIN"/>
        <result property="name" column="NAME"/>
        <result property="version" column="VERSION"/>
        <result property="isActive" column="IS_ACTIVE"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="facilityId" column="FACILITY_ID"/>
        <result property="cycle" column="CYCLE"/>
    </resultMap>

    <resultMap id="inspectionMap" type="app.snapshot.qure.facilities.dto.InspectionDto">
        <result property="inspectionId" column="INSPECTION_ID"/>
        <result property="submittedAt" column="SUBMITTED_AT"/>
        <result property="result" column="RESULT"/>
        <result property="facilityId" column="FACILITY_ID"/>
        <result property="inspectorId" column="INSPECTOR_ID"/>
    </resultMap>

    <!-- 목록 -->
    <select id="getFacilitiesList" resultMap="facilityMap">
        SELECT *
        FROM FACILITIES
        ORDER BY FACILITY_ID DESC
    </select>

    <!-- 검색 (Oracle 문자열 연결 주의) -->
    <select id="searchFacilities" parameterType="string" resultMap="facilityMap">
        SELECT *
        FROM FACILITIES
        WHERE LOWER(NAME)   LIKE '%' || LOWER(#{q}) || '%'
           OR LOWER(DOMAIN) LIKE '%' || LOWER(#{q}) || '%'
        ORDER BY FACILITY_ID DESC
    </select>

    <!-- 단건 조회 -->
    <select id="getFacilitiesInfo" parameterType="int" resultMap="facilityMap">
        SELECT *
        FROM FACILITIES
        WHERE FACILITY_ID = #{facilityId}
    </select>

    <!-- 등록: FACILITY_ID를 시퀀스로 생성 -->
    <insert id="insertFacilities" parameterType="app.snapshot.qure.facilities.dto.FacilitiesDto">
        <!--  오라클 시퀀스로 PK 채우기 -->
        <selectKey keyProperty="facilityId" resultType="int" order="BEFORE">
            SELECT FACILITY_SEQ.NEXTVAL FROM DUAL
        </selectKey>

        <!-- INSERT -->
        INSERT INTO FACILITIES(
        FACILITY_ID, DOMAIN, NAME, FLOOR, ZONE, ADDRESS,
        CREATED_AT, UPDATED_AT,INSPECTOR_ID
        ) VALUES (
        #{facilityId}, #{domain}, #{name}, #{floor}, #{zone}, #{address},
        CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, #{inspectorId}
        )
    </insert>



    <!-- 수정 -->
    <update id="updateFacilities" parameterType="app.snapshot.qure.facilities.dto.FacilitiesDto">
        UPDATE FACILITIES
        SET DOMAIN = #{domain},
            NAME = #{name},
            FLOOR = #{floor},
            ZONE = #{zone},
            ADDRESS = #{address, jdbcType=VARCHAR},
            INSPECTOR_ID = #{inspectorId}
        WHERE FACILITY_ID = #{facilityId}
    </update>

    <select id="findById" parameterType="int" resultType="app.snapshot.qure.facilities.dto.FacilitiesDto">
        SELECT FACILITY_ID, DOMAIN, NAME, FLOOR, ZONE, ADDRESS,
            GPS_LAT, GPS_LNG, STATUS, MEMO, CREATED_AT, UPDATED_AT,
            MANAGERS_ID, INSPECTOR_ID
        FROM FACILITIES
        WHERE FACILITY_ID = #{id}
    </select>


    <!-- 삭제 (email 파라미터는 사용하지 않음) -->
    <delete id="deleteFacilities">
        DELETE FROM FACILITIES WHERE FACILITY_ID = #{facilityId}
    </delete>

    <!-- 설비별 템플릿 -->
    <select id="findTemplatesByFacilityId" parameterType="int" resultMap="templateMap">
        SELECT *
        FROM CHECKLIST_TEMPLATES
        WHERE FACILITY_ID = #{facilityId}
        ORDER BY CREATED_AT DESC
    </select>

    <!-- 점검 목록 (설비별) -->
    <select id="findInspectionByFacilityId" parameterType="int" resultMap="inspectionMap">
        SELECT INSPECTION_ID, SUBMITTED_AT, RESULT, FACILITY_ID, INSPECTOR_ID
        FROM INSPECTIONS
        WHERE FACILITY_ID = #{facilityId}
        ORDER BY SUBMITTED_AT DESC, INSPECTION_ID DESC
    </select>

    <!-- 점검 목록 (설비별 + 기간) -->
    <select id="findInspectionByFacilityIdAndPeriod" resultMap="inspectionMap">
        SELECT INSPECTION_ID, SUBMITTED_AT, RESULT, FACILITY_ID, INSPECTOR_ID
        FROM INSPECTIONS
        WHERE FACILITY_ID = #{facilityId}
          AND TRUNC(SUBMITTED_AT) BETWEEN #{startD} AND #{endD}
        ORDER BY SUBMITTED_AT DESC, INSPECTION_ID DESC
    </select>

</mapper>
